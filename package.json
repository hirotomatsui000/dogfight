{
  "name": "contested-skies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser flight-combat game with fictional aircraft over a Poland-inspired landscape: single player, training and online multiplayer.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/build-single.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "server": "node src/server/main.ts",
    "start": "node src/server/main.ts"
  },
  "dependencies": {
    "@fontsource/rajdhani": "5.3.0",
    "three": "0.186.1",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.2",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
