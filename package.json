{
  "name": "contested-skies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser multiplayer flight-combat prototype with fictional aircraft over a Poland-inspired landscape.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/build-single.ts",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/rajdhani": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
